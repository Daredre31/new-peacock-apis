NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Atlas: use a different database name per environment. URL-encode special characters in the password.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/peacock_academy_dev?retryWrites=true&w=majority
# Cloud Redis often needs rediss:// (with TLS). Use whatever your provider gives you.
REDIS_URL=redis://default:PASSWORD@HOST:PORT

CORS_ORIGIN=http://localhost:5173
# COOKIE_DOMAIN=.yourschool.com
TRUST_PROXY_HOPS=0

# Generate each one separately (see command below)
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
CSRF_SECRET=
DOCS_ENABLED=true
# WORKERS_ENABLED=true

# Student passport photos are stored in Cloudinary (Dashboard > API Keys). Without these, the photo routes answer 503.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Emails (password reset links, notifications) go out through Resend. Set both or neither.
# MAIL_FROM must use a domain you verified in Resend (Dashboard > Domains), e.g. Peacock Academy <no-reply@yourschool.com>
# Without them: development prints emails to the console, production sends nothing.

