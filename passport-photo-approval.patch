+import type { ScopeService } from '../../common/scope/scope.service';
+import type { ImageStore } from '../../integrations/imageStore';
+import type { AuditService } from '../audit/audit.service';
+import type { AuthModule } from '../auth/auth.module';
+import type { NotificationService } from '../notifications/notification.service';
+import { linkRepository } from '../users/link.repository';
+import { studentRepository } from '../users/student.repository';
+import { createPassportPhotoRouter } from './submission.routes';
+import { submissionRepository } from './submission.repository';
+import { createPassportPhotoService } from './submission.service';
+
+/** Students and parents propose a passport photo; an admin approves it. The admin's own direct upload (in the users module) is unchanged. */
+export function createPassportPhotosModule(deps: {
+  audit: AuditService;
+  auth: AuthModule;
+  scope: ScopeService;
+  notifier: NotificationService;
+  images: ImageStore;
+}) {
+  const service = createPassportPhotoService({
+    repo: submissionRepository, students: studentRepository, links: linkRepository,
+    images: deps.images, notifier: deps.notifier, audit: deps.audit,
+  });
+  return { router: createPassportPhotoRouter({ service, authenticate: deps.auth.middleware.authenticate, scope: deps.scope }), service };
+}
diff --git a/src/modules/passport-photos/submission.model.ts b/src/modules/passport-photos/submission.model.ts
new file mode 100644
index 0000000..ab49ade
--- /dev/null
+++ b/src/modules/passport-photos/submission.model.ts
@@ -0,0 +1,43 @@
+import mongoose, { type Model, type Types } from 'mongoose';
+
+export const SUBMISSION_STATUS = { PENDING: 'PENDING', APPROVED: 'APPROVED', REJECTED: 'REJECTED' } as const;
+export type SubmissionStatus = (typeof SUBMISSION_STATUS)[keyof typeof SUBMISSION_STATUS];
+export const UPLOADER_ROLES = ['STUDENT', 'PARENT'] as const;
+export type UploaderRole = (typeof UPLOADER_ROLES)[number];
+
+/** One row per student: the latest photo someone proposed, and what the admin decided about it. */
+export interface PassportSubmissionDocument {
+  studentId: Types.ObjectId;
+  uploadedBy: Types.ObjectId;
+  uploaderRole: UploaderRole;
+  /** Cloudinary URL of the proposed photo. Null once it was rejected and removed. */
+  url: string | null;
+  status: SubmissionStatus;
+  reason: string | null;
+  reviewedBy: Types.ObjectId | null;
+  reviewedAt: Date | null;
+  submittedAt: Date;
+  createdAt: Date;
+  updatedAt: Date;
+}
+
+const schema = new mongoose.Schema<PassportSubmissionDocument>(
+  {
+    studentId: { type: mongoose.Schema.Types.ObjectId, required: true },
+    uploadedBy: { type: mongoose.Schema.Types.ObjectId, required: true },
+    uploaderRole: { type: String, enum: UPLOADER_ROLES, required: true },
+    url: { type: String, trim: true, maxlength: 500, default: null },
+    status: { type: String, enum: Object.values(SUBMISSION_STATUS), default: SUBMISSION_STATUS.PENDING },
+    reason: { type: String, trim: true, maxlength: 300, default: null },
+    reviewedBy: { type: mongoose.Schema.Types.ObjectId, default: null },
+    reviewedAt: { type: Date, default: null },
+    submittedAt: { type: Date, required: true },
+  },
+  { timestamps: true, versionKey: false },
+);
+schema.index({ studentId: 1 }, { unique: true });
+schema.index({ status: 1, submittedAt: 1 });
+
+export const PassportSubmissionModel: Model<PassportSubmissionDocument> =
+  (mongoose.models.PassportSubmission as Model<PassportSubmissionDocument> | undefined) ??
+  mongoose.model<PassportSubmissionDocument>('PassportSubmission', schema);
diff --git a/src/modules/passport-photos/submission.repository.ts b/src/modules/passport-photos/submission.repository.ts
new file mode 100644
index 0000000..5192a87
--- /dev/null
+++ b/src/modules/passport-photos/submission.repository.ts
@@ -0,0 +1,92 @@
+import type { Types } from 'mongoose';
+import { skipOf } from '../../common/utils/pagination';
+import {
+  PassportSubmissionModel, SUBMISSION_STATUS, type PassportSubmissionDocument, type SubmissionStatus, type UploaderRole,
+} from './submission.model';
+
+type Row = PassportSubmissionDocument & { _id: Types.ObjectId };
+
+export interface SubmissionRecord {
+  studentId: string;
+  uploadedBy: string;
+  uploaderRole: UploaderRole;
+  url: string | null;
+  status: SubmissionStatus;
+  reason: string | null;
+  reviewedBy: string | null;
+  reviewedAt: Date | null;
+  submittedAt: Date;
+}
+
+const toRecord = (r: Row): SubmissionRecord => ({
+  studentId: r.studentId.toString(),
+  uploadedBy: r.uploadedBy.toString(),
+  uploaderRole: r.uploaderRole,
+  url: r.url ?? null,
+  status: r.status,
+  reason: r.reason ?? null,
+  reviewedBy: r.reviewedBy ? r.reviewedBy.toString() : null,
+  reviewedAt: r.reviewedAt ?? null,
+  submittedAt: r.submittedAt,
+});
+
+const OBJECT_ID = /^[a-f0-9]{24}$/;
+
+async function find(studentId: string): Promise<SubmissionRecord | null> {
+  if (!OBJECT_ID.test(studentId)) return null;
+  const row = await PassportSubmissionModel.findOne({ studentId }).lean<Row>();
+  return row ? toRecord(row) : null;
+}
+
+/** A new photo replaces whatever was there before and goes back to PENDING. */
+async function savePending(input: { studentId: string; uploadedBy: string; uploaderRole: UploaderRole; url: string; now: Date }): Promise<SubmissionRecord> {
+  const row = await PassportSubmissionModel.findOneAndUpdate(
+    { studentId: input.studentId },
+    {
+      $set: {
+        uploadedBy: input.uploadedBy, uploaderRole: input.uploaderRole, url: input.url, status: SUBMISSION_STATUS.PENDING,
+        reason: null, reviewedBy: null, reviewedAt: null, submittedAt: input.now,
+      },
+    },
+    { upsert: true, new: true, runValidators: true },
+  ).lean<Row>();
+  return toRecord(row);
+}
+
+/** Moves PENDING to a decision in one atomic step. Returns null if it was not pending, so two admins cannot both decide. */
+async function decide(
+  studentId: string,
+  to: 'APPROVED' | 'REJECTED',
+  by: string,
+  extra: { reason?: string | null; url?: string | null; now: Date },
+): Promise<SubmissionRecord | null> {
+  if (!OBJECT_ID.test(studentId)) return null;
+  const set: Record<string, unknown> = { status: to, reviewedBy: by, reviewedAt: extra.now, reason: extra.reason ?? null };
+  if (extra.url !== undefined) set.url = extra.url;
+  const row = await PassportSubmissionModel.findOneAndUpdate(
+    { studentId, status: SUBMISSION_STATUS.PENDING }, { $set: set }, { new: true },
+  ).lean<Row>();
+  return row ? toRecord(row) : null;
+}
+
+/** Undo for a decision whose follow-up step failed. */
+async function reopen(studentId: string, url: string): Promise<void> {
+  await PassportSubmissionModel.updateOne(
+    { studentId },
+    { $set: { status: SUBMISSION_STATUS.PENDING, reviewedBy: null, reviewedAt: null, reason: null, url } },
+  );
+}
+
+async function setUrl(studentId: string, url: string): Promise<void> {
+  await PassportSubmissionModel.updateOne({ studentId }, { $set: { url } });
+}
+
+async function list(status: SubmissionStatus, o: { page: number; limit: number }): Promise<{ items: SubmissionRecord[]; total: number }> {
+  const [rows, total] = await Promise.all([
+    PassportSubmissionModel.find({ status }).sort({ submittedAt: 1, _id: 1 }).skip(skipOf(o.page, o.limit)).limit(o.limit).lean<Row[]>(),
+    PassportSubmissionModel.countDocuments({ status }),
+  ]);
+  return { items: rows.map(toRecord), total };
+}
+
+export const submissionRepository = { find, savePending, decide, reopen, setUrl, list };
