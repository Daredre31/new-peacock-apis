+export interface BuiltQuestion {
+  type: QuestionType;
+  text: string;
+  options: { key: string; text: string }[] | null;
+  correctAnswer: string | string[];
+  marks: number;
+  topic: string | null;
+  difficulty: Difficulty;
+  explanation: string | null;
